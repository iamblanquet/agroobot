# Configuración del Servidor TESA
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_tesa_agritech_2026

# Configuración del Bot de Telegram (Opcional en desarrollo local)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_MINI_APP_URL=http://localhost:3000

# Configuración de Supergrupo con Temas (Forum Topics)
# ID del supergrupo (empieza con -100...)
TELEGRAM_SUPERGROUP_ID=
# IDs numéricos de los temas/topics (obtenlos escribiendo /id en cada tema)
TELEGRAM_THREAD_REPORTES=
TELEGRAM_THREAD_INCIDENCIAS=
TELEGRAM_THREAD_TABLERO=

# Base de datos SQLite (Ruta relativa o absoluta)
DB_PATH=./server/db/tesa_campo.sqlite

# Supabase (fase de conexión y migración gradual; no reemplaza SQLite todavía)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Activar solo después de verificar que el esquema y usuarios estén migrados.
SUPABASE_AUTH_ENABLED=false

# Retiro de SQLite y modo exclusivo PostgreSQL / Supabase
# Poner en 'true' para desactivar SQLite y auto-seeding una vez completada la migración
DISABLE_SQLITE=false

# Portabilidad PostgreSQL / Amazon RDS / Aurora
# Cadena de conexión estándar (opcional para conexión directa o migración a AWS RDS)
# DATABASE_URL=postgresql://usuario:password@host:5432/database?sslmode=require


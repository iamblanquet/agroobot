{
  "name": "agroobot-tesa",
  "version": "1.0.0",
  "description": "Sistema de Operación de Campo y Tablero de Control - Patrón TESA (Telegram Entry, Standalone API, Offline Storage)",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "seed": "node server/db/seed.js",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "node server/index.js",
    "render-build": "npm install --include=dev && cd client && npm install --include=dev && npm run build",
    "render-start": "node server/index.js"
  },
  "keywords": [
    "tesa",
    "telegram-webapp",
    "field-operations",
    "offline-first",
    "sqlite",
    "react",
    "render"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^0.66.0",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1"
  }
}
